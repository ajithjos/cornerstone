# Local gcloud configuration name on your laptop.
GCP_CONFIG_NAME=cornerstone-prod

# GCP project id, not the human-readable project name.
GCP_PROJECT_ID=

# Zone of the VM backend, for example us-central1-f.
GCP_ZONE=

# Single VM instance name that will run the Docker stack.
GCP_INSTANCE_NAME=

# Leave blank when `gcloud compute ssh` should use your current OS Login user.
VM_SSH_USER=

# Release root on the VM.
VM_APP_ROOT=/opt/cornerstone
VM_KEEP_RELEASES=5

# Public DNS name and public web origin.
VM_DOMAIN=cornerstone.dhenara.com
CORNERSTONE_FRONTEND_PUBLIC_URL=https://cornerstone.dhenara.com
CORNERSTONE_DEVELOPER_DOCS_URL=

# Compose and runtime wiring on the VM.
CORNERSTONE_VM_COMPOSE_PROJECT_NAME=cornerstone-vm
CORNERSTONE_HTTP_PORT=80
CORNERSTONE_CONTROL_PLANE_PORT=8788
CORNERSTONE_FRONTEND_PORT=80
CORNERSTONE_POSTGRES_PORT=55433
CORNERSTONE_DEV_USERNAME_SIGNIN_ENABLED=false

CORNERSTONE_POSTGRES_DB=cornerstone
CORNERSTONE_POSTGRES_ADMIN_USER=cornerstone_admin
CORNERSTONE_POSTGRES_APP_USER=cornerstone_app

# Hosted runtime directories.
CORNERSTONE_RUNTIME_DATA_ROOT=/var/lib/cornerstone
CORNERSTONE_POSTGRES_DATA_DIR=/var/lib/cornerstone/data/01/postgres
CORNERSTONE_ARTIFACTS_DIR=/var/lib/cornerstone/data/01/artifacts
CORNERSTONE_EXPORTS_DIR=/var/lib/cornerstone/data/01/exports

# Required hosted secret name.
GCP_RUNTIME_ENV_SECRET_NAME=cornerstone-runtime-env

# Legacy compatibility template.
# Active tracked production setup env now lives at:
#   deploy/config/environments/prod.gcp.env
#
# Active runtime secret input now lives at:
#   deploy/vm/local/secrets/runtime-env.json
#
# Active runtime env consumed on the VM is rendered to:
#   deploy/vm/.env

CORNERSTONE_VM_COMPOSE_PROJECT_NAME=cornerstone-vm
CORNERSTONE_POSTGRES_IMAGE=postgres:16-alpine
CORNERSTONE_RUST_IMAGE=rust:1.93.0-slim-bookworm
CORNERSTONE_RUNTIME_IMAGE=debian:bookworm-slim
CORNERSTONE_NGINX_IMAGE=nginx:1.29-alpine

CORNERSTONE_WORKSPACE_HOST=/opt/cornerstone/current
CORNERSTONE_HTTP_PORT=80
CORNERSTONE_POSTGRES_PORT=55433
CORNERSTONE_CONTROL_PLANE_PORT=8788
CORNERSTONE_FRONTEND_PORT=80

CORNERSTONE_FRONTEND_PUBLIC_URL=https://cornerstone.dhenara.com
CORNERSTONE_DEV_USERNAME_SIGNIN_ENABLED=false

CORNERSTONE_POSTGRES_DB=cornerstone
CORNERSTONE_POSTGRES_ADMIN_USER=cornerstone_admin
CORNERSTONE_POSTGRES_APP_USER=cornerstone_app

CORNERSTONE_POSTGRES_DATA_DIR=/var/lib/cornerstone/data/01/postgres
CORNERSTONE_ARTIFACTS_DIR=/var/lib/cornerstone/data/01/artifacts
CORNERSTONE_EXPORTS_DIR=/var/lib/cornerstone/data/01/exports
CORNERSTONE_FRONTEND_BUILD_HOST=/opt/cornerstone/current/fe/flutter/apps/cornerstone/build/web

GCP_RUNTIME_ENV_SECRET_NAME=cornerstone-runtime-env
